

# Puerto donde escucha este microservicio (ms-pedidos usa el 3004).
PORT=3004
# 127.0.0.1 = solo acepta conexiones desde el mismo equipo (el gateway Apache estará en ese mismo equipo)
HOST=127.0.0.1

# Conexión a MySQL (base de datos propia de ms-pedidos).
# Ponga aquí su contraseña real SOLO en su .env, nunca en este archivo.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pedidos_db
DB_USER=pedidos_user
DB_PASSWORD=cambia-esta-clave

# La misma clave en todos los microservicios del grupo (la de ms-usuarios)
JWT_SECRET=cambie-esta-frase-por-una-larga-y-secreta
CLIENTES_URL=http://127.0.0.1:3003