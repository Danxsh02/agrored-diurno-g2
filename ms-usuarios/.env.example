# Copie este archivo como .env y ajuste los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

PORT=3001
HOST=127.0.0.1

# Roles válidos de la empresa, separados por comas
ROLES=administrador,despacho,flota

# Base de datos MySQL de este microservicio
DB_HOST=localhost
DB_PORT=3306
DB_NAME=usuarios_db
DB_USER=usuarios_user
DB_PASSWORD=una-clave-segura

# Clave con la que se firman los tokens JWT.
# DEBE SER LA MISMA en todos los microservicios del grupo: con ella cada uno
# verifica el token sin preguntarle a ms-usuarios. Use una frase larga y secreta.
JWT_SECRET=cambie-esta-frase-por-una-larga-y-secreta
# Tiempo de validez del token
JWT_EXPIRA=8h
