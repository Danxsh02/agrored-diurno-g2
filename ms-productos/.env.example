# Copie este archivo como .env y ajuste los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Puerto donde escucha este microservicio.

PORT=3002

# 127.0.0.1 = solo acepta conexiones desde el mismo equipo (el gateway Apache estará en ese mismo equipo)
HOST=127.0.0.1

# Conexión a MySQL (base de datos propia de este microservicio).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=productos_db
DB_USER=productos_user
DB_PASSWORD=cambiar-por-tu-clave

ROLES=administrador,comercial,produccion
# La misma clave en todos los microservicios del grupo (la de ms-usuarios)
JWT_SECRET=cambie-esta-frase-por-una-larga-y-secreta